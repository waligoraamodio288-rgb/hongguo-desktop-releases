+    def activate(self, job):
+        """Promote only after the renderer has applied the first visible frame.
+
+        Rebuild download bookkeeping asynchronously; never delay presentation
+        on metadata/network access or run a second encoding gate.
+        """
+        with self.guard:
+            if job.cancelled.is_set() or job.failed or not job.prewarm_parent:
+                return
+            if job.video_mode == "native":
+                value = self.native.snapshot(job.id) if self.native else None
+                if (not value or not value.get("visible") or not value.get("outputReady")
+                        or job.activation_revision is None
+                        or value.get("revision", -1) < job.activation_revision):
+                    raise HTTPException(409, "Standby activation not applied")
+            job.prewarm_parent = None
+        def promote():
+            try:
+                if job.cancelled.is_set():
+                    return
+                if self.on_activate:
+                    self.on_activate(job, job.series_id, job.episode)
+                    return
+            except Exception:
+                pass  # Speculative queue maintenance cannot stop playback.
+        try:
+            threading.Thread(target=promote, name="desktop-standby-promote", daemon=True).start()
+        except RuntimeError:
+            pass  # Playback ownership has transferred; queue refresh is optional.
